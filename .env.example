# ============================================================================
# HomeopathyOne (.in) – Environment Configuration Template
# Copy this file to .env and provide your production credentials
# ============================================================================

# ── 1. Backend REST API ──────────────────────────────────────────────────────
API_BASE_URL=https://api.homeopathyone.in/v1
API_TIMEOUT_SECONDS=30

# ── 2. Currency & Exchange Rates ─────────────────────────────────────────────
# Open Exchange Rates / ExchangeRate-API baseline endpoint
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/INR
EXCHANGE_RATE_CACHE_TTL_MINUTES=60

# ── 3. Domestic Payment Gateway: Razorpay (India Baseline / INR) ─────────────
RAZORPAY_KEY_ID=rzp_live_homeopathyone_sample_key
RAZORPAY_MERCHANT_NAME=HomeopathyOne Health Solutions
RAZORPAY_CURRENCY=INR

# ── 4. Global Payment Gateway: Stripe (International Cross-Border) ───────────
STRIPE_PUBLISHABLE_KEY=pk_live_51HomeopathyOneSampleKey98234
STRIPE_MERCHANT_IDENTIFIER=merchant.in.homeopathyone.app
STRIPE_URL_SCHEME=hoapp

# ── 5. Video Consultation Engine: Agora RTC ──────────────────────────────────
AGORA_APP_ID=sample_agora_rtc_app_id_homeopathyone

# ── 6. Firebase & Push Notifications ─────────────────────────────────────────
FIREBASE_PROJECT_ID=homeopathyone-prod
FCM_SENDER_ID=982341209341

# ── 7. Environment Mode ──────────────────────────────────────────────────────
ENVIRONMENT=production
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
